# compose 本地一键启动：复制为 .env 后按需改密码/端口。
# 注意：PG_PORT 用 5433，避免和宿主机已有的 5432 冲突。

PG_USER=postgres
PG_PASSWORD=postgres123
PG_DB=todo-agent
PG_PORT=5433

ES_PORT=9200

REDIS_PASSWORD=redis123
REDIS_PORT=6380

OLLAMA_PORT=11434

APP_PORT=8080

# KEK 走库（db_system_configs），留空即可；库里没配才需要填。
MODEL_KEY_ENC_KEY=
